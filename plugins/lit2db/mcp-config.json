{
  "mcpServers": {
    "lit2db": {
      "command": "sh",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/lit2db-python",
        "${CLAUDE_PLUGIN_ROOT}/mcp/lit2db_mcp/server.py"
      ],
      "env": {
        "PYTHONPATH": "${CLAUDE_PLUGIN_ROOT}/src",
        "LIT2DB_DB_PATH": "${CLAUDE_PLUGIN_ROOT}/examples/demo.db"
      }
    }
  }
}
